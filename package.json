{
  "name": "smc-ar",
  "version": "1.0.0",
  "private": true,
  "description": "SMC - AR – Universal Web-Based Augmented Reality Platform",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm install --prefix server && npm install --prefix client && npm run build:server && npm run build:client",
    "start": "npm --prefix server run start",
    "test": "npm --prefix server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
